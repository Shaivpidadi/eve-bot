{
  "name": "bot-eve",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Bot — always-on AI teammates with their own computer, built on Vercel eve and Next.js.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "reset": "node scripts/reset.mjs",
    "export": "tsx scripts/export.mjs",
    "import": "tsx scripts/import.mjs",
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "agent:dev": "eve dev",
    "agent:build": "eve build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "jev:report": "npx --yes tsx scripts/jev-report.mjs",
    "qa": "node qa/run.mjs",
    "qa:transfer": "node qa/transfer.mjs",
    "metrics": "npx --yes tsx scripts/metrics.mjs"
  },
  "dependencies": {
    "@agent-browser/eve": "^0.39.1",
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@base-ui/react": "^1.9.0",
    "@novnc/novnc": "^1.7.0",
    "@opentelemetry/otlp-transformer": "0.208.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@vercel/agent-runs": "0.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/connect": "^2.5.2",
    "@vercel/sandbox": "^3.8.0",
    "ai": "^7.0.140",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "durable-harness": "0.0.1-beta.6",
    "eve": "^0.82.0",
    "jose": "^5.10.0",
    "lucide-react": "^1.57.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "just-bash": "^3.4.2",
    "microsandbox": "^0.5.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
